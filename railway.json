{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -e .[asgi]"
  },
  "deploy": {
        "startCommand": "bash -c 'uvicorn asgi_app:app --host 0.0.0.0 --port $PORT & UV=$!; python aha_watchdog.py; kill -9 $UV; exit 1'",

    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "ALLOWED_ORIGINS": "*",
    "LOG_LEVEL": "info"
  }
}
